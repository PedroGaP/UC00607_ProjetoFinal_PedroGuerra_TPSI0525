{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Project",
      "type": "shell",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",

        "${workspaceFolder}\\main.cpp",
        "${workspaceFolder}\\lib\\vetor.cpp",
        "${workspaceFolder}\\models\\Colaborador.cpp",
        "${workspaceFolder}\\models\\ItemCalendario.cpp",
        "${workspaceFolder}\\utils\\utils.cpp",
        "-o",
        "${workspaceFolder}\\program.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
